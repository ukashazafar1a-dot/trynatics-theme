    "collapsible_content_LWJkbN": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_3CPLrr": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is your return policy?",
            "icon": "none",
            "row_content": "<p>Not eligible for a Return or an Exchange: items purchased on sale or as a part of a promotion, including any item purchased as a part of <strong>'HOLIDAY PROMOS, BLACK FRIDAY, CYBER MONDAY, FLASH SALES, and SECRET SALES.' </strong>For eligible items, we offer refunds, gift card, store credit, or an exchange<strong>within 15 days of delivery date for full priced items with tags attached & in original, unworn condition</strong>(restrictions apply). If you return for a refund, the return costs are deducted from the total of your refund. An Exchange, Gift Card, and or purchase via Shop Now (within our Loop return platform) will not incur any handling fees.<br/><br/>You must ship back your items with the label we provide, otherwise your return may be rejected.<br/><br/>We reserve the right to refuse returns on items that have been worn, stained/soiled, laundered, or altered in any way. This includes such marks as bodily fluids, deodorant stains & removed/tampered with liners.<br/><br/><br/><br/><em>Please note: If we receive a non 12th Tribe item with your return, we are not responsible for it and we cannot return it to you.</em></p>",
            "page": ""
          }
        },
        "collapsible_row_GFYby6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I submit a return request?",
            "icon": "none",
            "row_content": "<p>You can start your return request by clicking <a href=\"https://12thtribe.loopreturns.com/#/\"><span style=\"text-decoration:underline\">here</span></a>.</p>",
            "page": ""
          }
        },
        "collapsible_row_KhxRya": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What items are not eligible for return or exchange?",
            "icon": "none",
            "row_content": "<p>Items that are NON-RETURNABLE and NON-EXCHANGEABLE and include:</p><p>SALE & FINAL SALE MARKED ITEMS</p><p>HATS</p><p>JEWELRY</p><p>ACCESSORIES</p><p>INTIMATES</p><p>VINTAGE GARMENTS</p><p>MASKS</p><p>THRASHER SHORTS*</p><p>*These are made to order and are eligible for gift cards ONLY.<br/><br/><br/><strong>ANY AND ALL ITEMS OUTSIDE OF THE 15-DAY POLICY ARE NON-RETURNABLE.</strong><br/>This also includes HOLIDAY PROMOS, BLACK FRIDAY, CYBER MONDAY, FLASH SALES, and SECRET SALES.</p>",
            "page": ""
          }
        },
        "collapsible_row_mL9eQd": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is the cost for return shipping?",
            "icon": "none",
            "row_content": "<p>If you select to return for a refund, the return cost of $9.95 is deducted from the total of your refund.</p><p>If you return for a Gift Card or Exchange, we will provide you a pre-paid* label.</p><p><em>*Vintage Thrasher Shorts are not eligible for a pre-paid return label.</em></p>",
            "page": ""
          }
        }
      },
