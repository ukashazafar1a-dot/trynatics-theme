    "collapsible_content_Nk7VAX": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_BfFmpF": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How can I contact you about my order?",
            "icon": "none",
            "row_content": "<p>Have questions about your order or need assistance? We're here to help!</p><p><strong>Phone:</strong> XXXXXXXXXXXXX<br/><strong>Email:</strong> <a>XXXXXXXXXXXXXXXXXX</a></p><p>Don't hesitate to reach out—our team is ready to assist you!</p>",
            "page": ""
          }
        },
        "collapsible_row_ReCrhj": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What are your shipping options?",
            "icon": "none",
            "row_content": "<p><strong>US OVERNIGHT SHIPPING:</strong> Next business day delivery by end of day.</p><p><strong>US EXPRESS SHIPPING:</strong> Delivery within 2-3 business days.</p><p><strong>US STANDARD SHIPPING: </strong>6-8 business days.</p><p><strong>DHL INTERNATIONAL STANDARD SHIPPING: </strong>8-14 business days.</p><p><strong>FREE US STANDARD SHIPPING </strong>offer is valid on orders $120 or more. No promo code is required to redeem free shipping, just select Standard Shipping during checkout. Offer is subject to change without notice.</p><p><em>*Shipping thresholds are subject to change during sales and promotional events. Be sure to check the latest details at checkout to see how you can qualify for free shipping!</em></p><p><strong>US EXPRESS ORDERS:</strong></p><p>Orders must be placed before 12 PM PST in order to be shipped within one business day. Any orders placed Friday after 12 PM PST through Sunday, will be sent out the following business day. <strong>Carrier delays may occur during the holidays.</strong></p><p><strong>DHL INTERNATIONAL STANDARD SHIPPING</strong></p><p>All prices are subject to change upon ordering. You will be contacted if necessary.<br/><br/><em>*Please note these shipping options reflect estimated average shipping times.</em><br/><br/>Your package is tendered to our carriers within 24 hours, during standard business days. Delivery times are dependent on the carrier.</p>",
            "page": ""
          }
        },
        "collapsible_row_hL9mAM": {
          "type": "collapsible_row",
          "settings": {
            "heading": "My package is Lost/Stolen/Damaged?",
            "icon": "none",
            "row_content": "<p><strong>TARQUOISE STORE PACKAGE PROTECTION</strong></p><p>If you insured your package with Tarquoise Store Package Protection, please reach out to us directly via live chat or send an email to <a>support@tarquoisestore.com</a>, and we’ll help resolve any issues related to lost, damaged in transit, or stolen packages.</p><p>Claims for packages marked as delivered but not received, and where there is no evidence of “porch piracy,” must be made within 5 days after the “delivery date” and no later than 15 days to ensure it was not mis-delivered or found on the premises. Claims for packages presumed lost (when the status is not marked as delivered) must be filed after 7 days (20 days for international) and within 30 days from the last scan.</p><p>If you did not include package protection with your order, Tarquoise Store is not responsible for any lost or stolen items. If you believe your package has been lost, please file a claim directly with the carrier.</p>",
            "page": ""
          }
        },
        "collapsible_row_yW3PrT": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if my package was returned to sender?",
            "icon": "none",
            "row_content": "<p>If your package has been returned to the sender due to an address discrepancy, Tarquoise Store will not be held responsible. Once the item is successfully returned, we will contact you regarding the shipment and provide further assistance.</p>",
            "page": ""
          }
        },
        "collapsible_row_UxUMqV": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I cancel my order or update the shipping address?",
