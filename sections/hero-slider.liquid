{% liquid
  assign enableSlider = true
  assign enableArrow = false
  if section.blocks.size > 0
    assign enableSlider = true
  endif
  assign height = 1 | divided_by: section.blocks.first.settings.image_mobile.aspect_ratio | times: 100
  assign newHeight = height | floor | minus: 100
%}

{% if enableSlider %}
  {% style %}
      .hero_main{
         display: inherit;
         --flkty-dot-color:{{section.settings.btnclr}};
      }
       .flickity-viewport {
        transition: height 0.2s;
      }
      .hero_slider_wrapper{
        margin-bottom:0;
      }

      .hero_slider_wrapper .flickity-viewport {
        position: absolute;
        width: 100%;
      }
       .hero_slider_wrapper:not(.flickity-enabled){
        display:flex;
        overflow:hidden;
        height:100%;
        width:100%;
        flex-wrap:no-wrap;
      }
      .hero_slider_wrapper:not(.flickity-enabled) .single_slide{
        width:100%;
        flex-basis:100%;
        flex-shrink:0;
      }
       .single_slide.carousel-cell{
        height:100%;
        width:100%;
          position:relative;
        min-height:100%;
      }
      .single_slide img{
        width:100%;
        max-width: 100%;
        display: block;
        height: auto;
        opacity:1 !important;
      }

      .hero_main{
        position:relative;
      }
    .btn_first{
      position: absolute;
    }
      .next-btn,
      .prev-btn{
        width: 50px;
        height: 50px;
        position:absolute;
        top:50%;
        transform: translateX(-50%);
        cursor:pointer;
        display:flex;
        align-items:center;
        justify-content:center;
        z-index:2;
        transition: 200ms right cubic-bezier(0, 1, 1, 1),200ms fill cubic-bezier(0, 1, 1, 1);
      }
      .next-btn svg,
      .prev-btn svg{
        width:25px;
        height:20px;
        fill:{{section.settings.btnclr}};
        transition: 200ms transform cubic-bezier(0, 1, 1, 1),200ms fill cubic-bezier(0, 1, 1, 1);
      }
      .next-btn svg g path,
      .prev-btn svg g{
        fill:{{section.settings.btnclr}};
      }
      .next-btn{
        right:10px;
        transform:rotate(-90deg);
      }
      .prev-btn{
        left:10px;
        transform:rotate(90deg);
      }
      .next-btn:is(:hover,:focus,:active){
        right:5px;
      }
      .prev-btn:is(:hover,:focus,:active){
        left:5px;
      }
      .next-btn:is(:hover,:focus,:active) svg g,
      .next-btn:is(:hover,:focus,:active) svg g path,
      .prev-btn:is(:hover,:focus,:active) svg g,
      .prev-btn:is(:hover,:focus,:active) svg g path{
        fill: {{section.settings.btnhover}};
      }
      .flickity-page-dots {
        bottom: 15px;
      }
      .flickity-page-dot{
        margin: 0 5px;
      }
      .flickity-page-dot {
        width: 12px;
        height: 12px;
        opacity: 1;
        background: transparent;
        border: 2px solid {{section.settings.btnclr}} !important;
      }
      .flickity-page-dot:is(:hover,:focus){
        outline:none;
        box-shadow:none;
      }
      .flickity-page-dot.is-selected {
        background: {{section.settings.btnclr}};
      }
      .btn_slide{
        position:absolute;
        width:100%;
        bottom:45px;
        z-index:9;
        display:flex;
        align-items:center;
        justify-content:center;
        gap:1em;
        flex-wrap:wrap;
      }
      .btn_custom{
        line-height:1 !important;
      }
    @media (max-width: 750px) {

          #shopify-section-{{ section.id }} .hero-media {
            {% if section.blocks.first.settings.image_mobile != blank %}
            padding-bottom:{{ 1 | divided_by: section.blocks.first.settings.image_mobile.aspect_ratio | times: 100 }}%;
          {% else %}
            padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
          {% endif %}
            height: 100%;
          }
         .hero_slider_wrapper.flickity-enabled{
            {% if section.blocks.first.settings.image_mobile != blank %}
            padding-bottom:{{ 1 | divided_by: section.blocks.first.settings.image_mobile.aspect_ratio | times: 100 }}%;
          {% else %}
            padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
          {% endif %}
          }
          .custom_btn{
            font-size:11px !important;
          }
          .btn_slide{
            bottom:15px;
            gap:.6em;
          }
        }
      @media (min-width: 751px) {
          #shopify-section-{{ section.id }} .hero-media {
            padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
          }
          .hero_slider_wrapper.flickity-enabled{
            padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
          }
        }
      @media(max-width:750px){
        .single_slide.carousel-cell{
          height:100%;
          min-height:100%;
        }
        .hero_slider_wrapper.flickity-enabled .single_slide.carousel-cell{
           {% if section.blocks.first.settings.image_mobile != blank %}
            padding-bottom:{{ 1 | divided_by: section.blocks.first.settings.image_mobile.aspect_ratio | times: 100 }}%;
          {% else %}
            padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
          {% endif %}
        }
        {% if section.settings.show_arrow_on_mobile %}
          .next-btn,
          .prev-btn{
            display:none;
          }
        {% endif %}
        .next-btn,
        .prev-btn{
          width: 30px;
          height: 30px;
        }
        .next-btn{
          right:0px;
        }
        .prev-btn{
          left:0px;
        }
      }
    .hm-{{ section.id }} .image-wrap.desktop_img{
      display:block;
    }
    .hm-{{ section.id }}  .image-wrap.mobile_img{
     display:none;
    }
    @media(max-width:768px){
      .hm-{{ section.id }} .image-wrap.desktop_img{
        display:none;
      }
      .hm-{{ section.id }}  .image-wrap.mobile_img{
       display:block;
      }
    }
  {% endstyle %}

  <div class="hero_main hm-{{ section.id }}" style="">
    <div
      class="hero_slider_wrapper main-carousel {% if section.blocks.size > 1 %} hs-slider-main{% endif %}"
      data-arrows="{{ section.settings.show_arrow }}"
      data-dots="{{ section.settings.show_dots }}"
      data-autoplay="{{ section.settings.enable_rotation }}"
      data-rotation="{{ section.settings.rotation | append: '000' }}"
    >
      {% for block in section.blocks %}
        {% assign currentTime = 'now' | date: '%Y-%m-%d %H:%M:%S' %}
        {% assign userStartTime = block.settings.start_time %}
        {% assign userEndTime = block.settings.end_time %}
        {% assign showSlide = true %}

        {% if userStartTime != blank and currentTime < userStartTime %}
          {% assign showSlide = false %}
        {% endif %}

        {% if userEndTime != blank and currentTime > userEndTime %}
          {% assign showSlide = false %}
        {% endif %}

        {% if showSlide %}
          {% render 'slide-image',
            block: block,
            startTime: userStartTime,
            endTime: userEndTime,
            timeNow: currentTime,
            showSlide: showSlide
          %}
        {% else %}
          <script style="display:none;">
            [{
              image:{{ block.settings.image | json }},
              startTime:{{ userStartTime | json }},
              endTime:{{ userEndTime | json }},
              showSlide:{{showSlide}}
            }]
          </script>
        {% endif %}
      {% endfor %}
    </div>
    {% comment %} {% endcomment %}
    {% if section.settings.show_arrow and section.blocks.size > 1 %}
      <div class="next-btn">
        {% render 'slider-arrow-icon', classes: 'next-icon' %}
      </div>
      <div class="prev-btn">
        {% render 'slider-arrow-icon', classes: 'prev-icon' %}
      </div>
    {% endif %}
  </div>
{% endif %}

<script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Hero Slider",
  "class":"hero_slider_section",
  "settings": [
    {
      "type":"checkbox",
      "id":"enable_rotation",
      "label":"Enable Auto Rotation",
      "default":true
    },
    {
      "type":"range",
      "id":"rotation",
      "label":"Rotation Interval",
      "min":1,
      "max":8,
      "step":1,
      "unit":"sec",
      "default":5
    },
    {
      "type":"checkbox",
      "id":"show_arrow",
      "label":"Show Arrows",
      "default":true
    },
    {
      "type":"checkbox",
      "id":"show_dots",
      "label":"Show Dots",
      "default":true
    },
    {
      "type":"color",
      "id":"btnclr",
      "label":"Dots & Button Color",
      "default":"#000000"
    },
    {
      "type":"color",
      "id":"btnhover",
      "label":"Button Hover Color",
      "default":"#fbce0a"
    },
    {
      "type":"checkbox",
      "id":"show_arrow_on_mobile",
      "label":"Hide Arrows on Mobile",
      "default":true
    }
  ],
  "blocks":[
    {
      "type":"image",
      "name":"Slide",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image"
        },
        {
          "type": "header",
          "content": "Slide Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type":"header",
          "content":"Schedule Visibility"
        },
        {
          "type":"paragraph",
          "content":"Using store timezone and this format: YYYY-MM-DD HH:MM:SS Example: 2024-01-01 06:00:00"
        },
        {
          "type":"text",
          "id":"start_time",
          "label":"Start Date & Time"
        },
        {
          "type":"text",
          "id":"end_time",
          "label":"End Date & Time"
        },
        {
          "type": "header",
          "content": "Button 1"
        },
         {
          "type": "color",
          "label": "Button 1 BG Color",
          "id": "btn_bg_1",
           "default":"#fff"
        },
                {
          "type": "color",
          "id": "btn_clr_1",
          "label": "Button 1 Text Color",
                  "default":"#000"
        },
        {
          "type": "text",
          "id": "btn_text_1",
          "label": "Button 1 Text"
        },
        {
          "type": "url",
          "id": "btn_url1",
          "label": "Button 1 Link"

        },
         {
          "type": "header",
          "content": "Button 2"
        },

         {
          "type": "color",
          "label": "Button 2 BG Color",
          "id": "btn_bg_2",
           "default":"#fff"
        },
             {
          "type": "color",
          "id": "btn_clr_2",
          "label": "Button 2 Text Color",
               "default":"#000"
        },
        {
          "type": "text",
          "id": "btn_text_2",
          "label": "Button 2 Text"
        },
                {
          "type": "url",
          "id": "btn_url2",
          "label": "Button 2 Link"

        }
      ]
    }
  ],
  "presets":[
    {
      "name":"Hero Slider",
      "blocks":[
        {
          "type":"image"
        },
        {
          "type":"image"
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
